rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isInspector() {
      return isSignedIn() && request.auth.token.role == 'inspector';
    }

    function isSource() {
      // Claim-only — never trust users/{uid}.role (self-writable hole)
      return isAdmin() || (isSignedIn() && request.auth.token.role == 'source');
    }

    function isStaff() {
      return isAdmin() || isInspector();
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.uid == uid
                        && !('role' in request.resource.data)
                        && !('is_marketer' in request.resource.data)
                        && !('daily_buyer_limit' in request.resource.data));
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('email' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('created_at' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('daily_buyer_limit' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('is_marketer' in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                      !('username' in request.resource.data.diff(resource.data).affectedKeys())
                      || resource.data.username == null
                    ));
      allow delete: if isAdmin();
    }

    match /usernames/{name} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid', 'username'])
                    && !exists(/databases/$(database)/documents/usernames/$(name));
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /groups/{groupId} {
      allow read: if isStaff()
                  || (isSignedIn() && request.auth.uid in resource.data.memberUids);
      allow write: if isAdmin();
    }

    // Public car listings — MUST NOT contain owner_name / owner_phone
    match /cars/{carId} {
      allow list, get: if true;
      allow create, update: if isStaff()
        && !request.resource.data.keys().hasAny(['owner_name', 'owner_phone']);
      allow delete: if isStaff();
    }

    // Owner PII — staff only
    match /car_private/{carId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['owner_name', 'owner_phone', 'updated_at'])
        && request.resource.data.owner_name is string
        && request.resource.data.owner_phone is string;
      allow delete: if isStaff();
    }

    match /copy_events/{eventId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.created_at == request.time;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /buyer_leads/{leadId} {
      allow create: if isSignedIn()
                    && request.resource.data.marketer_uid == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'name', 'phone', 'description', 'marketer_uid',
                      'car_id', 'car_title', 'created_at'
                    ])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() == 11
                    && request.resource.data.description is string
                    && request.resource.data.car_id is string
                    && request.resource.data.car_id.size() > 0
                    && request.resource.data.car_title is string
                    && request.resource.data.car_title.size() > 0
                    && request.resource.data.created_at == request.time;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.marketer_uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Cap daily buyer counter: +1 only, never above users/{uid}.daily_buyer_limit
    function buyerDailyLimit(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.daily_buyer_limit is number
        ? get(/databases/$(database)/documents/users/$(uid)).data.daily_buyer_limit
        : 5;
    }

    function validBuyerCountWrite(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['count', 'uid', 'day'])
        && request.resource.data.count is number
        && request.resource.data.uid == uid
        && request.resource.data.day is string
        && request.resource.data.count >= 1
        && request.resource.data.count <= buyerDailyLimit(uid)
        && (
          (request.method == 'create' && request.resource.data.count == 1)
          || (request.method == 'update'
              && request.resource.data.count == resource.data.count + 1
              && request.resource.data.day == resource.data.day)
        );
    }

    match /daily_buyer_counts/{uid} {
      allow get, list: if isAdmin()
                       || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if validBuyerCountWrite(uid);
      allow delete: if isAdmin();
      match /days/{dayKey} {
        allow get, list: if isAdmin()
                         || (isSignedIn() && request.auth.uid == uid);
        allow create, update: if validBuyerCountWrite(uid)
                              && request.resource.data.day == dayKey;
        allow delete: if isAdmin();
      }
    }

    match /market_registry/{entryId} {
      allow read: if isSource();

      allow create: if isSource()
                    && request.resource.data.keys().hasAll([
                      'brand', 'model', 'year', 'trim', 'paint_condition',
                      'mileage_km', 'maintenance', 'price_egp', 'recorded_by_uid',
                      'created_at'
                    ])
                    && request.resource.data.brand is string
                    && request.resource.data.brand.size() > 0
                    && request.resource.data.model is string
                    && request.resource.data.model.size() > 0
                    && request.resource.data.year is int
                    && request.resource.data.year >= 1900
                    && request.resource.data.year <= 2100
                    && request.resource.data.trim is string
                    && request.resource.data.paint_condition is string
                    && request.resource.data.mileage_km is int
                    && request.resource.data.mileage_km >= 0
                    && request.resource.data.maintenance is string
                    && request.resource.data.price_egp is int
                    && request.resource.data.price_egp > 0
                    && request.resource.data.recorded_by_uid == request.auth.uid
                    && request.resource.data.created_at == request.time;

      allow update: if isSource()
                    && (
                      isAdmin()
                      || resource.data.recorded_by_uid == request.auth.uid
                    )
                    && request.resource.data.recorded_by_uid == resource.data.recorded_by_uid
                    && request.resource.data.created_at == resource.data.created_at;

      allow delete: if isSource()
                    && (
                      isAdmin()
                      || resource.data.recorded_by_uid == request.auth.uid
                    );
    }
  }
}