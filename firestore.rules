rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isInspector() {
      return isSignedIn() && request.auth.token.role == 'inspector';
    }

    function isStaff() {
      return isAdmin() || isInspector();
    }

    function isViewableCar() {
      // Deprecated — الـ status لم يعد visibility gate (تحوّل لـ label بس).
      // الفانكشن دي موجودة بس للتوافق مع النداءات القديمة في الكود المحلي.
      return true;
    }

    // ============== Users Collection ==============
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.uid == uid);
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('email' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('created_at' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('daily_buyer_limit' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                      !('username' in request.resource.data.diff(resource.data).affectedKeys())
                      || resource.data.username == null
                    ));
      allow delete: if isAdmin();
    }

    // Username reservation map.
    // - get (single doc): allowed for any signed-in user, used by
    //   checkUsernameAvailable() during onboarding (it needs to check
    //   one specific key). This is unavoidable — the client has to
    //   know whether a name is taken.
    // - list (full collection): admin-only. Prevents any signed-in user
    //   from harvesting the full username→uid map via getDocs().
    // - create: any signed-in user can claim a name for themselves,
    //   but only if the name is not already taken (the transaction in
    //   saveUsername() handles the race; this rule is the second line
    //   of defence).
    // - update: admin-only (changing an existing reservation is suspicious).
    // - delete: the owner can release their own reservation, or admin.
    match /usernames/{name} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasAll(['uid', 'username'])
                    && !exists(/databases/$(database)/documents/usernames/$(name));
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /groups/{groupId} {
      // الأدمن/المعاين يشوفوا كل المجموعات.
      // اليوزر المسجّل يشوف بس المجموعات اللي هو عضو فيها (memberUids فيها UID بتاعه).
      // ده بيسمح لـ marketer filter في /cars يجيب الـ UIDs من غير ما يعمل admin escalation.
      // الضيف ما يشوفش حاجة (request.auth = null).
      allow read: if isStaff()
                  || (isSignedIn() && request.auth.uid in resource.data.memberUids);
      allow write: if isAdmin();
    }

    // ============== Cars Collection ==============
    // الـ visibility model الحالي:
    // - list/get: public للجميع (ضيف، user، marketer، admin، inspector)
    //   ← ده متعمد لأن العربيات معروض للبيع والـ PWA هو live board.
    // - create/update: الأدمن + المعاين فقط (isStaff)
    // - delete: الأدمن فقط
    //
    // ⚠️ الـ marketer filter (assigned_to) متطبّق client-side فقط.
    // السبب: بيانات العربيات public anyway، والـ filter ده UX personalization
    // مش security boundary. Firestore rules مش بتقرأ مجموعات المسوّق (groups collection)
    // وبتتطلب join على groups لـ enforce server-side — مش practical.
    // الـ Firestore rules الحالية بترفض أي محاولة write من غير الأدمن/المعاين.
    match /cars/{carId} {
      allow list, get: if true;

      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /copy_events/{eventId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.created_at == request.time;
      // H23: staff-only read (admin + inspector) — البيانات دي حساسة
      // (مين اتصل برقم مين) ولازم ما تطلعش لليوزر العادي.
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Buyer leads entered by marketers
    match /buyer_leads/{leadId} {
      allow create: if isSignedIn()
                    && request.resource.data.marketer_uid == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'name', 'phone', 'description', 'marketer_uid', 'created_at'
                    ])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() == 11
                    && request.resource.data.description is string
                    && request.resource.data.created_at == request.time;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.marketer_uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Daily buyer counter — server-side enforced cap on leads/day.
    // Each marketer gets a subcollection `days/{cairoDate}`. The client
    // SDK uses runTransaction to atomically read+increment. We expose
    // the doc only to the owner + admin to avoid leaking counters.
    match /daily_buyer_counts/{uid} {
      allow get, list: if isAdmin()
                       || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn() && request.auth.uid == uid
                            && request.resource.data.keys().hasAll(['count', 'uid', 'day'])
                            && request.resource.data.count is number
                            && request.resource.data.uid == uid
                            && request.resource.data.day is string;
      allow delete: if isAdmin();
      match /days/{dayKey} {
        allow get, list: if isAdmin()
                         || (isSignedIn() && request.auth.uid == uid);
        allow create, update: if isSignedIn() && request.auth.uid == uid
                              && request.resource.data.keys().hasAll(['count', 'uid', 'day'])
                              && request.resource.data.count is number
                              && request.resource.data.uid == uid
                              && request.resource.data.day is string;
        allow delete: if isAdmin();
      }
    }
  }
}
