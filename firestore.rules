rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isInspector() {
      return isSignedIn() && request.auth.token.role == 'inspector';
    }

    function isSource() {
      return isAdmin() || (isSignedIn() && request.auth.token.role == 'source');
    }

    function isStaff() {
      return isAdmin() || isInspector();
    }

    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.uid == uid
                        && !('role' in request.resource.data)
                        && !('is_marketer' in request.resource.data)
                        && !('daily_buyer_limit' in request.resource.data));
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('email' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('created_at' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('daily_buyer_limit' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('is_marketer' in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                      !('username' in request.resource.data.diff(resource.data).affectedKeys())
                      || resource.data.username == null
                    ));
      allow delete: if isAdmin();
    }

    match /usernames/{name} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'username', 'created_at'])
                    && request.resource.data.username is string
                    && request.resource.data.username.size() > 0
                    && request.resource.data.username.size() <= 40
                    && !exists(/databases/$(database)/documents/usernames/$(name));
      allow update: if isAdmin();
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /groups/{groupId} {
      allow read: if isStaff()
                  || (isSignedIn() && request.auth.uid in resource.data.memberUids);
      allow write: if isAdmin();
    }

    // Public listings â€” must NOT contain owner_* or inspector_* PII
    match /cars/{carId} {
      allow list, get: if true;
      allow create, update: if isStaff()
        && !request.resource.data.keys().hasAny([
          'owner_name', 'owner_phone', 'inspector_name', 'inspector_phone'
        ]);
      allow delete: if isStaff();
    }

    // Owner PII â€” staff only
    match /car_private/{carId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['owner_name', 'owner_phone', 'updated_at'])
        && request.resource.data.owner_name is string
        && request.resource.data.owner_name.size() <= 120
        && request.resource.data.owner_phone is string
        && request.resource.data.owner_phone.size() <= 40;
      allow delete: if isStaff();
    }

    // Inspector contact â€” signed-in users only (not guests)
    match /car_contact/{carId} {
      allow read: if isSignedIn();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['inspector_name', 'inspector_phone', 'updated_at'])
        && request.resource.data.inspector_name is string
        && request.resource.data.inspector_name.size() <= 120
        && request.resource.data.inspector_phone is string
        && request.resource.data.inspector_phone.size() <= 40;
      allow delete: if isStaff();
    }

    match /copy_events/{eventId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.created_at == request.time
                    && request.resource.data.keys().hasOnly([
                      'uid', 'username', 'email', 'carId', 'created_at'
                    ])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && (request.resource.data.username == null
                        || (request.resource.data.username is string
                            && request.resource.data.username.size() <= 40))
                    && (request.resource.data.carId == null
                        || (request.resource.data.carId is string
                            && request.resource.data.carId.size() <= 128));
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Creates only via Admin SDK (/api/buyers) â€” enforces daily limit server-side
    match /buyer_leads/{leadId} {
      allow create: if false;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.marketer_uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /daily_buyer_counts/{uid} {
      allow get, list: if isAdmin()
                       || (isSignedIn() && request.auth.uid == uid);
      // Counter writes only via Admin SDK (/api/buyers). Clients cannot bump counters.
      allow create, update, delete: if false;
      match /days/{dayKey} {
        allow get, list: if isAdmin()
                         || (isSignedIn() && request.auth.uid == uid);
        allow create, update, delete: if false;
      }
    }

    match /market_registry/{entryId} {
      allow read: if isSource();

      allow create: if isSource()
                    && request.resource.data.keys().hasAll([
                      'brand', 'model', 'year', 'trim', 'paint_condition',
                      'mileage_km', 'maintenance', 'price_egp', 'recorded_by_uid',
                      'created_at'
                    ])
                    && request.resource.data.brand is string
                    && request.resource.data.brand.size() > 0
                    && request.resource.data.brand.size() <= 80
                    && request.resource.data.model is string
                    && request.resource.data.model.size() > 0
                    && request.resource.data.model.size() <= 80
                    && request.resource.data.year is int
                    && request.resource.data.year >= 1900
                    && request.resource.data.year <= 2100
                    && request.resource.data.trim is string
                    && request.resource.data.trim.size() <= 80
                    && request.resource.data.paint_condition is string
                    && request.resource.data.paint_condition.size() <= 80
                    && request.resource.data.mileage_km is int
                    && request.resource.data.mileage_km >= 0
                    && request.resource.data.maintenance is string
                    && request.resource.data.maintenance.size() <= 500
                    && request.resource.data.price_egp is int
                    && request.resource.data.price_egp > 0
                    && request.resource.data.recorded_by_uid == request.auth.uid
                    && request.resource.data.created_at == request.time;

      allow update: if isSource()
                    && (
                      isAdmin()
                      || resource.data.recorded_by_uid == request.auth.uid
                    )
                    && request.resource.data.recorded_by_uid == resource.data.recorded_by_uid
                    && request.resource.data.created_at == resource.data.created_at;

      allow delete: if isSource()
                    && (
                      isAdmin()
                      || resource.data.recorded_by_uid == request.auth.uid
                    );
    }
  }
}