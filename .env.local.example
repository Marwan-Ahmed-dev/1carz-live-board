# =====================================================
# Firebase Client SDK (public — exposed to the browser)
# =====================================================
# Get these from Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=carz-live-board.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=carz-live-board
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=carz-live-board.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# رقم الواتساب الخاص بالأدمن (يُستخدم في زر "تواصل عبر واتساب")
# مثال: 201234567890
NEXT_PUBLIC_ADMIN_WHATSAPP=201234567890

# =====================================================
# Firebase Admin SDK (SERVER-ONLY — never expose to client)
# =====================================================
# Get these from Firebase Console → Project Settings → Service Accounts
# On Vercel: add the same variables in Project Settings → Environment Variables
FIREBASE_PROJECT_ID=carz-live-board
FIREBASE_CLIENT_EMAIL=your-service-account@carz-live-board.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
