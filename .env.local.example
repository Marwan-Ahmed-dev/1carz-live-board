# رقم الواتساب الخاص بالأدمن (يُستخدم في زر "تواصل عبر واتساب")
# مثال: 201234567890
NEXT_PUBLIC_ADMIN_WHATSAPP=201234567890

# Firebase Admin SDK (لـ scripts/set-admin.js فقط - لا تستخدم في client code)
# احصل عليه من Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=carz-live-board
FIREBASE_CLIENT_EMAIL=your-service-account@carz-live-board.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"