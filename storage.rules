rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    match /cars/{carId}/{fileName} {
      // Download URLs with tokens still work for <img>. Listing a folder
      // must not be public — that leaked unpublished photos by car id.
      allow get: if true;
      allow list: if isAdmin();
      allow write, delete: if isAdmin();
    }
  }
}
